{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["docs/**", "**/dist/**", "**/coverage/**", "**/.next/**", "**/.packed/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["gsap", "gsap/**", "@gsap/**"],
            "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/react/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react-aria*", "react-aria*/**", "@react-aria/**", "@react-stately/**"],
                "message": "Only src/_engines/** may import the behaviour engine (ARCHITECTURE.md §4.1 L4, §9.2)."
              },
              {
                "group": ["@nizivo/icons", "@nizivo/icons/**", "lucide*", "lucide*/**"],
                "message": "Core imports no icon package: inline a glyph in _internal/glyphs.tsx behind a slot prop, and let consumers pass @nizivo/icons (ARCHITECTURE.md §4.1 L6, §14.2)."
              },
              {
                "group": ["gsap", "gsap/**", "@gsap/**"],
                "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/react/src/_engines/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nizivo/icons", "@nizivo/icons/**", "lucide*", "lucide*/**"],
                "message": "Core imports no icon package (ARCHITECTURE.md §4.1 L6, §14.2)."
              },
              {
                "group": ["gsap", "gsap/**", "@gsap/**"],
                "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
              }
            ]
          }
        ]
      }
    }
  ]
}
