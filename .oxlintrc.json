{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["docs/**", "**/dist/**", "**/coverage/**", "**/.next/**", "**/.packed/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["gsap", "gsap/**", "@gsap/**"],
            "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/react/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react-aria*",
                  "react-aria*/**",
                  "@react-aria/**",
                  "@react-stately/**",
                  "@base-ui/**"
                ],
                "message": "Only src/_engines/** may import the behaviour engine (ARCHITECTURE.md §4.1 L4, §9.2)."
              },
              {
                "group": ["@nizivo/icons", "@nizivo/icons/**", "lucide*", "lucide*/**"],
                "message": "Core imports no icon package: inline a glyph in _internal/glyphs.tsx behind a slot prop, and let consumers pass @nizivo/icons (ARCHITECTURE.md §4.1 L6, §14.2)."
              },
              {
                "group": ["@nizivo/charts", "@nizivo/charts/**"],
                "message": "Core never imports @nizivo/charts: it reaches charts only through slots typed ReactNode (ARCHITECTURE.md §4.1 L6, §14.1)."
              },
              {
                "group": ["gsap", "gsap/**", "@gsap/**"],
                "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/react/src/_engines/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nizivo/icons", "@nizivo/icons/**", "lucide*", "lucide*/**"],
                "message": "Core imports no icon package (ARCHITECTURE.md §4.1 L6, §14.2)."
              },
              {
                "group": ["@nizivo/charts", "@nizivo/charts/**"],
                "message": "Core never imports @nizivo/charts: it reaches charts only through slots typed ReactNode (ARCHITECTURE.md §4.1 L6, §14.1)."
              },
              {
                "group": ["gsap", "gsap/**", "@gsap/**"],
                "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/charts/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nizivo/react", "@nizivo/react/**"],
                "message": "@nizivo/charts imports nothing from @nizivo/react: use the vendored src/_shared helpers (generated by nz gen) and slots (ARCHITECTURE.md §4.1 L6, §14.1)."
              },
              {
                "group": [
                  "react-aria*",
                  "react-aria*/**",
                  "@react-aria/**",
                  "@react-stately/**",
                  "@nizivo/icons",
                  "@nizivo/icons/**",
                  "lucide*",
                  "lucide*/**",
                  "d3-scale",
                  "d3-scale/**"
                ],
                "message": "Charts' runtime imports are react, d3-shape and d3-array only; d3-scale is the opt-in ./d3 adapter's optional peer (ARCHITECTURE.md §14.1)."
              },
              {
                "group": ["gsap", "gsap/**", "@gsap/**"],
                "message": "GSAP is banned: its licence is not OSI-approved (ARCHITECTURE.md §19.3)."
              }
            ]
          }
        ]
      }
    }
  ]
}
