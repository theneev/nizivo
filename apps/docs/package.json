{
  "name": "@nizivo/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Nizivo UI docs site: Fumadocs on Next.js, built as a static export (ARCHITECTURE.md §18.2)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate.ts && fumadocs-mdx && node scripts/next.ts build",
    "dev": "node scripts/generate.ts && fumadocs-mdx && node scripts/next.ts dev",
    "typecheck": "node scripts/generate.ts && fumadocs-mdx && node scripts/next.ts typegen && tsc --noEmit -p .",
    "serve": "node scripts/serve.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@nizivo/icons": "workspace:*",
    "@nizivo/react": "workspace:*",
    "@nizivo/tokens": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "geist": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nizivo/tooling": "workspace:*",
    "@nizivo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 129",
    "safari >= 17.5",
    "ios_saf >= 17.5"
  ]
}
