{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "packages/tooling/tsconfig/*.json",
    "packages/tooling/tsdown-preset/index.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.example.tsx",
        "!test/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
