{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "pnpm-workspace.yaml",
    "packages/tooling/tsconfig/*.json",
    "packages/tooling/tsdown-preset/index.ts",
    "contracts/layers.css",
    "contracts/vocabulary.json",
    "docs/research/phase2/spikes/s4-spring/spring-results.json"
  ],
  "globalEnv": ["NZ_TOKEN_PREFIX"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.example.tsx",
        "!test/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@nizivo/tooling#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/runner/pack.ts"],
      "outputs": []
    },
    "@nizivo/tooling#test": {
      "dependsOn": [
        "^build",
        "@nizivo/react#build",
        "@nizivo/tokens#build",
        "@nizivo/charts#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/RELEASING.md",
        "$TURBO_ROOT$/contracts/api/**",
        "$TURBO_ROOT$/packages/react/package.json",
        "$TURBO_ROOT$/packages/tokens/package.json",
        "$TURBO_ROOT$/packages/icons/package.json",
        "$TURBO_ROOT$/packages/charts/package.json",
        "$TURBO_ROOT$/packages/react/src/**/*.client.tsx",
        "$TURBO_ROOT$/packages/charts/src/**",
        "$TURBO_ROOT$/packages/react/src/contracts/**",
        "$TURBO_ROOT$/packages/react/src/_internal/cx.ts",
        "$TURBO_ROOT$/fixtures/runner/pack.ts"
      ],
      "outputs": []
    },
    "@nizivo/react#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.example.tsx",
        "!test/**",
        "!scripts/visual/**",
        "!.size-limit.ts",
        "!SIZES.md",
        "!README.md",
        "!W*-RESULTS.md",
        "$TURBO_ROOT$/packages/charts/src/*/*.css"
      ],
      "outputs": ["dist/**"]
    },
    "@nizivo/react#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/visual/baselines/**",
        "!SIZES.md",
        "!W*-RESULTS.md",
        "$TURBO_ROOT$/fixtures/floor-lane/png.ts"
      ],
      "outputs": []
    },
    "@nizivo/react#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/visual/**",
        "!scripts/visual/**",
        "!SIZES.md",
        "!W*-RESULTS.md",
        "$TURBO_ROOT$/packages/charts/src/*/*.css"
      ],
      "outputs": []
    },
    "@nizivo/react#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/charts/src/*/*.css"],
      "outputs": []
    },
    "@nizivo/charts#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.example.tsx",
        "!test/**",
        "!README.md",
        "!W*-RESULTS.md",
        "$TURBO_ROOT$/packages/react/scripts/css/**",
        "$TURBO_ROOT$/packages/tooling/stylelint-config/**",
        "$TURBO_ROOT$/packages/react/src/**/component.json"
      ],
      "outputs": ["dist/**"]
    },
    "@nizivo/charts#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/react/scripts/css/**"],
      "outputs": []
    },
    "@nizivo/charts#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/react/src/**/component.json"],
      "outputs": []
    },
    "@nizivo/docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!RESULTS.md",
        "!scripts/smoke.ts",
        "!scripts/serve.ts",
        "$TURBO_ROOT$/contracts/api/**",
        "$TURBO_ROOT$/packages/react/package.json",
        "$TURBO_ROOT$/packages/react/src/**/*.example.tsx",
        "$TURBO_ROOT$/packages/react/src/**/component.json",
        "$TURBO_ROOT$/packages/tokens/src/code-owned/**",
        "$TURBO_ROOT$/design/component-map.json",
        "$TURBO_ROOT$/docs/ARCHITECTURE.md",
        "$TURBO_ROOT$/docs/figma/11-w2-server-safe-components.md",
        "$TURBO_ROOT$/docs/figma/12-w3-forms.md",
        "$TURBO_ROOT$/docs/figma/13-w4-menu-tabs.md",
        "$TURBO_ROOT$/fixtures/floor-lane/RESULTS.md",
        "$TURBO_ROOT$/packages/charts/package.json",
        "$TURBO_ROOT$/packages/charts/src/index.ts",
        "$TURBO_ROOT$/packages/charts/src/**/*.example.tsx",
        "$TURBO_ROOT$/packages/charts/src/**/*.tsx"
      ],
      "outputs": ["out/**"]
    },
    "@nizivo/docs#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!RESULTS.md",
        "$TURBO_ROOT$/packages/react/package.json",
        "$TURBO_ROOT$/packages/react/src/**/*.example.tsx",
        "$TURBO_ROOT$/packages/react/src/**/component.json"
      ],
      "outputs": [
        ".source/**",
        ".generated/**",
        "app/docs/?generated?/**",
        ".next/types/**",
        "next-env.d.ts"
      ]
    },
    "@nizivo/docs#smoke": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!RESULTS.md"],
      "outputs": []
    }
  }
}
