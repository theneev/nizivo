{
  "name": "nizivo",
  "private": true,
  "description": "Nizivo UI monorepo: an open-source React design system by Neev Technologies",
  "homepage": "https://nizivo.neevtechnologies.in",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theneev/nizivo.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings && oxfmt --check && turbo run lint",
    "gen:check": "nz gen --check && turbo run build --filter=@nizivo/react --filter=@nizivo/charts --output-logs=errors-only && nz api --check",
    "test:dist": "pnpm --filter @nizivo/react exec vitest run --config test/built/vitest.config.ts",
    "check:a11y": "node packages/tokens/scripts/a11y.ts --check",
    "check:release": "node packages/tooling/release/check.ts",
    "size": "pnpm --filter @nizivo/react size",
    "docs:check": "turbo run smoke --filter=@nizivo/docs",
    "floor:check": "node fixtures/floor-lane/gen-w5.ts --check",
    "check": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm gen:check && pnpm test && pnpm build && pnpm check:a11y && pnpm size && pnpm floor:check && pnpm test:dist && pnpm check:release && pnpm docs:check",
    "format": "oxfmt",
    "changeset": "changeset",
    "test:browser": "pnpm --filter @nizivo/react test:browser",
    "test:overlay": "pnpm --filter @nizivo/react test:overlay",
    "test:visual": "pnpm --filter @nizivo/react test:visual",
    "fixture:next": "pnpm --filter @nizivo/fixture-runner fixture:next",
    "fixture:vite": "pnpm --filter @nizivo/fixture-runner fixture:vite",
    "fixture:vite-ssr": "pnpm --filter @nizivo/fixture-runner fixture:vite-ssr",
    "fixture:react-router": "pnpm --filter @nizivo/fixture-runner fixture:react-router",
    "fixture:astro": "pnpm --filter @nizivo/fixture-runner fixture:astro",
    "fixture:charts": "pnpm --filter @nizivo/fixture-runner fixture:charts",
    "floor": "node fixtures/floor-lane/run.ts",
    "floor:gen": "node fixtures/floor-lane/gen-w5.ts",
    "cache:audit": "node packages/tooling/cache-audit/audit.ts",
    "gate": "node packages/tooling/gate/gate.ts",
    "check:full": "pnpm check && node packages/tooling/release/lanes.ts",
    "release": "node packages/tooling/release/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@nizivo/tooling": "workspace:*",
    "@typescript/typescript6": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@12.11.2"
}
