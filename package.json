{
  "name": "nizivo",
  "private": true,
  "description": "Nizivo UI monorepo: an open-source React design system by Neev Technologies",
  "homepage": "https://nizivo.neevtechnologies.in",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theneev/nizivo.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings && oxfmt --check && turbo run lint",
    "gen:check": "nz gen --check && turbo run build --filter=@nizivo/react --output-logs=errors-only && nz api --check",
    "test:dist": "pnpm --filter @nizivo/react exec vitest run --config test/built/vitest.config.ts",
    "check:a11y": "node packages/tokens/scripts/a11y.ts --check",
    "check:release": "node packages/tooling/release/check.ts",
    "docs:check": "turbo run build --filter=@nizivo/docs && pnpm --filter @nizivo/docs smoke",
    "check": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm gen:check && pnpm test && pnpm build && pnpm check:a11y && pnpm test:dist && pnpm check:release && pnpm docs:check",
    "format": "oxfmt",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@nizivo/tooling": "workspace:*",
    "@typescript/typescript6": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@12.11.2"
}
