{
  "$comment": "generated by nz api; do not edit",
  "classes": [
    "nz-app-shell",
    "nz-app-shell-frame",
    "nz-app-shell-main",
    "nz-app-shell-mobile-top-bar",
    "nz-app-shell-sidebar",
    "nz-app-shell-skip",
    "nz-app-shell-tab-bar",
    "nz-app-shell-top-bar"
  ],
  "component": "app-shell",
  "entry": "./css/app-shell.css",
  "hooks": [
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-canvas"
      },
      "name": "--nz-app-shell-bg",
      "reads": [
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-app-shell",
          "slot": "app-shell"
        }
      ]
    },
    {
      "fallback": {
        "kind": "expression",
        "tokens": ["--nz-grid-margin", "--nz-section-gap"],
        "value": "var(--nz-section-gap) var(--nz-grid-margin)"
      },
      "name": "--nz-app-shell-main-padding",
      "reads": [
        {
          "conditions": [],
          "property": "padding",
          "selector": ".nz-app-shell-main",
          "slot": "app-shell-main"
        }
      ]
    }
  ],
  "layers": ["nz.components"],
  "package": "@nizivo/react",
  "runtime": ["--nz-layout-bottom-inset"],
  "tokens": [
    "--nz-bg-canvas",
    "--nz-bg-inverse",
    "--nz-font-label-m-strong",
    "--nz-grid-margin",
    "--nz-layout-content-max",
    "--nz-radius-md",
    "--nz-section-gap",
    "--nz-space-2",
    "--nz-space-3",
    "--nz-space-4",
    "--nz-text-inverse",
    "--nz-text-primary",
    "--nz-tracking-label-m-strong",
    "--nz-z-chrome",
    "--nz-z-overlay"
  ],
  "version": 1
}
