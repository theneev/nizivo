{
  "$comment": "generated by nz api; do not edit",
  "classes": [
    "nz-select-chevron",
    "nz-select-group-label",
    "nz-select-icon",
    "nz-select-item",
    "nz-select-list",
    "nz-select-popup",
    "nz-select-separator",
    "nz-select-trigger",
    "nz-select-value"
  ],
  "component": "select",
  "entry": "./css/select.css",
  "hooks": [
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-surface"
      },
      "name": "--nz-select-bg",
      "reads": [
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-select-trigger",
          "slot": "select-trigger"
        }
      ]
    },
    {
      "fallback": {
        "kind": "private",
        "name": "--_nz-select-border",
        "values": [
          {
            "conditions": [],
            "selector": ".nz-select-trigger",
            "value": "var(--nz-border-control)",
            "when": {}
          }
        ]
      },
      "name": "--nz-select-border",
      "reads": [
        {
          "conditions": [],
          "property": "border",
          "selector": ".nz-select-trigger",
          "slot": "select-trigger"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-border-control-hover"
      },
      "name": "--nz-select-border-hover",
      "reads": [
        {
          "conditions": ["@media (hover: hover)"],
          "property": "border-color",
          "selector": ".nz-select-trigger:hover:not([data-disabled])",
          "slot": "select-trigger"
        }
      ]
    },
    {
      "fallback": {
        "kind": "private",
        "name": "--_nz-select-height",
        "values": [
          {
            "conditions": [],
            "selector": ".nz-select-trigger",
            "value": "var(--nz-size-control-md)",
            "when": {}
          },
          {
            "conditions": [],
            "selector": ".nz-select-trigger[data-size=\"lg\"]",
            "value": "var(--nz-size-control-lg)",
            "when": {
              "data-size": "lg"
            }
          },
          {
            "conditions": [],
            "selector": ".nz-select-trigger[data-size=\"sm\"]",
            "value": "var(--nz-size-control-sm)",
            "when": {
              "data-size": "sm"
            }
          }
        ]
      },
      "name": "--nz-select-height",
      "reads": [
        {
          "conditions": [],
          "property": "block-size",
          "selector": ".nz-select-trigger",
          "slot": "select-trigger"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-radius-md"
      },
      "name": "--nz-select-radius",
      "reads": [
        {
          "conditions": [],
          "property": "border-radius",
          "selector": ".nz-select-trigger",
          "slot": "select-trigger"
        }
      ]
    }
  ],
  "layers": ["nz.components"],
  "package": "@nizivo/react",
  "runtime": ["--nz-transform-origin", "--nz-trigger-width"],
  "tokens": [
    "--nz-bg-disabled",
    "--nz-bg-hover",
    "--nz-bg-surface",
    "--nz-bg-surface-raised",
    "--nz-border-control",
    "--nz-border-control-hover",
    "--nz-border-subtle",
    "--nz-border-width-default",
    "--nz-duration-fade",
    "--nz-duration-fast",
    "--nz-easing-enter",
    "--nz-easing-exit",
    "--nz-elevation-4",
    "--nz-font-label-m",
    "--nz-font-label-s",
    "--nz-radius-md",
    "--nz-radius-sm",
    "--nz-size-control-lg",
    "--nz-size-control-md",
    "--nz-size-control-sm",
    "--nz-size-icon-sm",
    "--nz-space-1-5",
    "--nz-space-2",
    "--nz-space-3",
    "--nz-text-disabled",
    "--nz-text-primary",
    "--nz-text-secondary",
    "--nz-text-tertiary",
    "--nz-z-overlay"
  ],
  "version": 1
}
