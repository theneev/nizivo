{
  "$comment": "generated by nz api; do not edit",
  "classes": [
    "nz-dialog-backdrop",
    "nz-dialog-body",
    "nz-dialog-content",
    "nz-dialog-description",
    "nz-dialog-footer",
    "nz-dialog-popup",
    "nz-dialog-positioner",
    "nz-dialog-title"
  ],
  "component": "dialog",
  "entry": "./css/dialog.css",
  "hooks": [
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-surface-raised"
      },
      "name": "--nz-dialog-bg",
      "reads": [
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-dialog-popup",
          "slot": "dialog-popup"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-radius-2xl"
      },
      "name": "--nz-dialog-radius",
      "reads": [
        {
          "conditions": [],
          "property": "border-radius",
          "selector": ".nz-dialog-popup",
          "slot": "dialog-popup"
        }
      ]
    },
    {
      "fallback": {
        "kind": "private",
        "name": "--_nz-dialog-width",
        "values": [
          {
            "conditions": [],
            "selector": ".nz-dialog-popup",
            "value": "30rem",
            "when": {}
          },
          {
            "conditions": [],
            "selector": ".nz-dialog-popup[data-size=\"lg\"]",
            "value": "40rem",
            "when": {
              "data-size": "lg"
            }
          },
          {
            "conditions": [],
            "selector": ".nz-dialog-popup[data-size=\"sm\"]",
            "value": "25rem",
            "when": {
              "data-size": "sm"
            }
          }
        ]
      },
      "name": "--nz-dialog-width",
      "reads": [
        {
          "conditions": [],
          "property": "inline-size",
          "selector": ".nz-dialog-popup",
          "slot": "dialog-popup"
        }
      ]
    }
  ],
  "layers": ["nz.components"],
  "package": "@nizivo/react",
  "runtime": [],
  "tokens": [
    "--nz-bg-scrim",
    "--nz-bg-subtle",
    "--nz-bg-surface-raised",
    "--nz-duration-base",
    "--nz-duration-fade",
    "--nz-duration-spring",
    "--nz-easing-enter",
    "--nz-easing-exit",
    "--nz-easing-spring",
    "--nz-elevation-4",
    "--nz-font-body-l",
    "--nz-font-heading-h3",
    "--nz-radius-2xl",
    "--nz-scale-enter",
    "--nz-space-2",
    "--nz-space-3",
    "--nz-space-4",
    "--nz-space-5",
    "--nz-space-6",
    "--nz-space-8",
    "--nz-text-primary",
    "--nz-text-secondary",
    "--nz-tracking-heading-h3",
    "--nz-z-overlay"
  ],
  "version": 1
}
