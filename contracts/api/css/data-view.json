{
  "$comment": "generated by nz api; do not edit",
  "classes": [
    "nz-data-view",
    "nz-data-view-item",
    "nz-data-view-item-link",
    "nz-data-view-list",
    "nz-data-view-table"
  ],
  "component": "data-view",
  "entry": "./css/data-view.css",
  "hooks": [
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-hover"
      },
      "name": "--nz-data-view-item-bg-hover",
      "reads": [
        {
          "conditions": ["@media (hover: hover)"],
          "property": "background",
          "selector": ".nz-data-view-item[data-interactive]:hover",
          "slot": "data-view-item"
        }
      ]
    }
  ],
  "layers": ["nz.components"],
  "package": "@nizivo/react",
  "runtime": [],
  "tokens": [
    "--nz-bg-hover",
    "--nz-border-subtle",
    "--nz-border-width-default",
    "--nz-font-label-m-strong",
    "--nz-size-touch-min",
    "--nz-space-0-5",
    "--nz-space-3",
    "--nz-space-4",
    "--nz-tracking-label-m-strong"
  ],
  "version": 1
}
