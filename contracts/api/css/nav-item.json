{
  "$comment": "generated by nz api; do not edit",
  "classes": ["nz-nav-item", "nz-nav-item-count", "nz-nav-item-icon", "nz-nav-item-label"],
  "component": "nav-item",
  "entry": "./css/nav-item.css",
  "hooks": [
    {
      "fallback": {
        "kind": "literal",
        "value": "transparent"
      },
      "name": "--nz-nav-item-bg",
      "reads": [
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-nav-item",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-brand-subtle"
      },
      "name": "--nz-nav-item-bg-current",
      "reads": [
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-nav-item[aria-current=\"page\"]",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-muted"
      },
      "name": "--nz-nav-item-bg-hover",
      "reads": [
        {
          "conditions": ["@media (hover: hover)"],
          "property": "background",
          "selector": ".nz-nav-item:hover:not([aria-current=\"page\"], [data-disabled])",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-muted"
      },
      "name": "--nz-nav-item-count-bg",
      "reads": [
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-nav-item-count",
          "slot": "nav-item-count"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-bg-brand"
      },
      "name": "--nz-nav-item-count-bg-current",
      "reads": [
        {
          "conditions": ["@container nz-sidebar (inline-size < 10rem)"],
          "property": "background",
          "selector": ".nz-nav-item:has( > .nz-nav-item-count) > .nz-nav-item-icon:after",
          "slot": "nav-item-icon"
        },
        {
          "conditions": [],
          "property": "background",
          "selector": ".nz-nav-item[aria-current=\"page\"] > .nz-nav-item-count",
          "slot": "nav-item-count"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-text-secondary"
      },
      "name": "--nz-nav-item-fg",
      "reads": [
        {
          "conditions": [],
          "property": "color",
          "selector": ".nz-nav-item",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-text-brand"
      },
      "name": "--nz-nav-item-fg-current",
      "reads": [
        {
          "conditions": [],
          "property": "color",
          "selector": ".nz-nav-item[aria-current=\"page\"]",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-space-3"
      },
      "name": "--nz-nav-item-gap",
      "reads": [
        {
          "conditions": [],
          "property": "gap",
          "selector": ".nz-nav-item",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-size-control-md"
      },
      "name": "--nz-nav-item-height",
      "reads": [
        {
          "conditions": [],
          "property": "block-size",
          "selector": ".nz-nav-item",
          "slot": "nav-item"
        },
        {
          "conditions": ["@container nz-sidebar (inline-size < 10rem)"],
          "property": "inline-size",
          "selector": ".nz-nav-item",
          "slot": "nav-item"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-icon-secondary"
      },
      "name": "--nz-nav-item-icon-fg",
      "reads": [
        {
          "conditions": [],
          "property": "color",
          "selector": ".nz-nav-item-icon",
          "slot": "nav-item-icon"
        }
      ]
    },
    {
      "fallback": {
        "kind": "token",
        "name": "--nz-radius-md"
      },
      "name": "--nz-nav-item-radius",
      "reads": [
        {
          "conditions": [],
          "property": "border-radius",
          "selector": ".nz-nav-item",
          "slot": "nav-item"
        }
      ]
    }
  ],
  "layers": ["nz.components"],
  "package": "@nizivo/react",
  "runtime": [],
  "tokens": [
    "--nz-bg-brand",
    "--nz-bg-brand-subtle",
    "--nz-bg-muted",
    "--nz-bg-pressed",
    "--nz-duration-fast",
    "--nz-easing-standard",
    "--nz-font-label-m",
    "--nz-font-label-m-strong",
    "--nz-font-label-m-strong-font-weight",
    "--nz-icon-brand",
    "--nz-icon-secondary",
    "--nz-radius-full",
    "--nz-radius-md",
    "--nz-size-control-md",
    "--nz-size-icon-md",
    "--nz-space-0-5",
    "--nz-space-1-5",
    "--nz-space-2",
    "--nz-space-3",
    "--nz-text-brand",
    "--nz-text-disabled",
    "--nz-text-on-brand",
    "--nz-text-primary",
    "--nz-text-secondary",
    "--nz-tracking-label-m",
    "--nz-tracking-label-m-strong"
  ],
  "version": 1
}
