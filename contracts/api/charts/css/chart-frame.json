  "component": "chart-frame",
  "entry": "./styles.css",
  "hooks": [
    {
      "fallback": {
        "kind": "literal",
        "value": "18 / 7"
      },
      "name": "--nz-chart-frame-aspect",
      "reads": [
        {
          "conditions": [],
          "property": "aspect-ratio",
          "selector": ".nz-chart-frame-body",
          "slot": "chart-frame-body"
        }
      ]
    },
    {
      "fallback": {
        "kind": "literal",
        "value": "2.75rem"
      },
      "name": "--nz-chart-frame-gutter",
      "reads": [
        {
          "conditions": [],
          "property": "min-inline-size",
          "selector": ".nz-chart-frame-y-ticks",
          "slot": "chart-frame-y-ticks"
        }
      ]
    }
  ],
  "layers": ["nz.components"],
  "package": "@nizivo/charts",
  "runtime": [],
  "tokens": [
    "--nz-bg-subtle",
    "--nz-border-default",
    "--nz-border-focus",
    "--nz-border-subtle",
    "--nz-border-width-default",
    "--nz-border-width-focus",
    "--nz-chart-grid",
    "--nz-chart-neutral",
    "--nz-chart-primary",
    "--nz-duration-chart-draw",
    "--nz-easing-standard",
    "--nz-font-body-m",
    "--nz-font-body-m-font-size",
    "--nz-font-body-m-line-height",
    "--nz-font-label-m",
    "--nz-font-label-m-strong",
    "--nz-radius-md",
    "--nz-radius-sm",
    "--nz-space-1",
