    "nz-chart-frame",
    "nz-chart-frame-body",
    "nz-chart-frame-caption",
    "nz-chart-frame-cell",
    "nz-chart-frame-details",
    "nz-chart-frame-details-summary",
    "nz-chart-frame-message",
    "nz-chart-frame-plot",
    "nz-chart-frame-skeleton",
