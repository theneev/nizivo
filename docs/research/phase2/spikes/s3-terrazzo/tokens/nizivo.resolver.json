{
  "name": "nz spike",
  "version": "2025.10",
  "sets": {
    "primitives": { "sources": [{ "$ref": "primitives.tokens.json" }] }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [{ "$ref": "theme-light.tokens.json" }],
        "dark":  [{ "$ref": "theme-dark.tokens.json" }]
      },
      "default": "light"
    },
    "motion": {
      "contexts": {
        "default": [{ "$ref": "motion-default.tokens.json" }],
        "reduced": [{ "$ref": "motion-reduced.tokens.json" }]
      },
      "default": "default"
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/primitives" },
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/modifiers/motion" }
  ]
}
