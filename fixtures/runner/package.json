{
  "name": "@nizivo/fixture-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Packs the @nizivo tarballs for the framework fixtures and runs their shared browser spec (ARCHITECTURE.md §18.1)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "pack:fixture": "node pack.ts",
    "fixture:next": "node next.ts",
    "fixture:vite": "node vite.ts",
    "fixture:vite-ssr": "node vite-ssr.ts",
    "fixture:astro": "node astro.ts",
    "fixture:charts": "node charts.ts --engines chromium,webkit,firefox"
  },
  "devDependencies": {
    "@nizivo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
