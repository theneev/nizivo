{
  "name": "@nizivo/react",
  "version": "0.0.0",
  "description": "Nizivo React components: server-first, accessible, themed by @nizivo/tokens",
  "keywords": [
    "components",
    "design-system",
    "nizivo",
    "react",
    "rsc"
  ],
  "homepage": "https://nizivo.neevtechnologies.in",
  "bugs": "https://github.com/theneev/nizivo/issues",
  "license": "Apache-2.0",
  "author": "Neev Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theneev/nizivo.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./augment": {
      "types": "./dist/augment.d.ts",
      "default": "./dist/augment.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./container": {
      "types": "./dist/container/index.d.ts",
      "default": "./dist/container/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "default": "./dist/dialog/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./heading": {
      "types": "./dist/heading/index.d.ts",
      "default": "./dist/heading/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "default": "./dist/image/index.js"
    },
    "./inline": {
      "types": "./dist/inline/index.d.ts",
      "default": "./dist/inline/index.js"
    },
    "./kbd": {
      "types": "./dist/kbd/index.d.ts",
      "default": "./dist/kbd/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "default": "./dist/select/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "default": "./dist/separator/index.js"
    },
    "./stack": {
      "types": "./dist/stack/index.d.ts",
      "default": "./dist/stack/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "default": "./dist/tooltip/index.js"
    },
    "./css/base.css": "./dist/css/base.css",
    "./css/button.css": "./dist/css/button.css",
    "./css/container.css": "./dist/css/container.css",
    "./css/dialog.css": "./dist/css/dialog.css",
    "./css/grid.css": "./dist/css/grid.css",
    "./css/heading.css": "./dist/css/heading.css",
    "./css/image.css": "./dist/css/image.css",
    "./css/inline.css": "./dist/css/inline.css",
    "./css/kbd.css": "./dist/css/kbd.css",
    "./css/select.css": "./dist/css/select.css",
    "./css/separator.css": "./dist/css/separator.css",
    "./css/stack.css": "./dist/css/stack.css",
    "./css/text.css": "./dist/css/text.css",
    "./css/tooltip.css": "./dist/css/tooltip.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "lint": "stylelint \"src/**/*.css\" \"styles/**/*.css\" --allow-empty-input",
    "check:dist": "tsdown && node scripts/build-css.ts && vitest run --config test/built/vitest.config.ts"
  },
  "dependencies": {
    "@nizivo/tokens": "workspace:*",
    "react-aria": "catalog:",
    "react-aria-components": "catalog:"
  },
  "devDependencies": {
    "@nizivo/stylelint-config": "workspace:*",
    "@nizivo/tsconfig": "workspace:*",
    "@nizivo/tsdown-preset": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "lightningcss": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
