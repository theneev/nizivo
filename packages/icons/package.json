{
  "name": "@nizivo/icons",
  "version": "0.3.0",
  "description": "Tree-shakable Lucide icons for Nizivo at the Figma stroke, plus brand glyphs",
  "keywords": [
    "icons",
    "lucide",
    "nizivo",
    "react"
  ],
  "homepage": "https://nizivo.neevtechnologies.in",
  "bugs": "https://github.com/theneev/nizivo/issues",
  "license": "Apache-2.0",
  "author": "Neev Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theneev/nizivo.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brands/*": {
      "types": "./dist/brands/*.d.ts",
      "default": "./dist/brands/*.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "node scripts/generate.ts && tsdown",
    "typecheck": "node scripts/generate.ts && tsc --noEmit -p . && tsc --noEmit -p scripts && tsc --noEmit -p test",
    "test": "node scripts/generate.ts && vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "@nizivo/tsconfig": "workspace:*",
    "@nizivo/tsdown-preset": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lucide-static": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "simple-icons": "catalog:",
    "svgo": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
