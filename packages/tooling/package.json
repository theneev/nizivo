{
  "name": "@nizivo/tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Nizivo repo tooling: the nz generator, CI checks and the spring generator",
  "license": "Apache-2.0",
  "bin": {
    "nz": "./bin/nz.ts"
  },
  "type": "module",
  "exports": {
    "./spring": "./spring/spring.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test/fixtures",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nizivo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "lightningcss": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
