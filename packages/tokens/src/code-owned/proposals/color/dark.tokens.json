{
  "color": {
    "bg": {
      "scrim": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.6,
          "hex": "#000000"
        },
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "bg/scrim",
            "reason": "Modal backdrop. Light n900 at 32% (designer evidence: 08 uses bg/inverse at 0.32); dark #000 at 60%, because bg/inverse is white in dark and brightens the page",
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      },
      "accent-hover": {
        "$type": "color",
        "$value": "{color.p.lime.300}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "bg/accent-hover",
            "reason": "Figma binds a mode-blind lime/400 primitive, so in dark hover equals rest. Dark value UNVERIFIED",
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      },
      "critical-hover": {
        "$type": "color",
        "$value": "{color.p.red.700}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "bg/critical-hover",
            "reason": "Critical button hover binds the red/700 primitive directly; white on red/700 is 8.26:1",
            "wcag": ["1.4.3"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      }
    },
    "text": {
      "on-critical": {
        "$type": "color",
        "$value": "{color.p.neutral.0}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "text/on-critical",
            "reason": "Foreground for bg/critical (white on red/600 5.69:1, on red/700 8.26:1)",
            "wcag": ["1.4.3"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "{color.p.lime.300}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "text/accent",
            "reason": "Toast action text; Figma used bg/accent as text (1.75:1 on white in the dark Toast). Light green/700, dark lime/300",
            "wcag": ["1.4.3"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      }
    },
    "icon": {
      "info": {
        "$type": "color",
        "$value": "{color.p.blue.400}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "icon/info",
            "reason": "Alert Info used icon/brand (green on blue); blue/600 light, blue/400 dark",
            "wcag": ["1.4.11"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      }
    },
    "border": {
      "control": {
        "$type": "color",
        "$value": "{color.p.neutral.500}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "border/control",
            "reason": "Input, checkbox, radio, switch-off track and select trigger boundaries; Figma used border/default and border/strong (1.27 and 1.57:1 on white)",
            "wcag": ["1.4.11"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      },
      "control-hover": {
        "$type": "color",
        "$value": "{color.p.neutral.400}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "border/control-hover",
            "reason": "Hover boundary for the controls on border/control",
            "wcag": ["1.4.11"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      }
    },
    "chart": {
      "warning": {
        "$type": "color",
        "$value": "{color.icon.warning}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "chart/warning",
            "reason": "ProgressBar tone=\"warning\" fill; Figma misuses text/warning as a fill. Interim alias of icon/warning",
            "wcag": ["1.4.11"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      },
      "critical": {
        "$type": "color",
        "$value": "{color.chart.negative}",
        "$extensions": {
          "app.nizivo.proposal": {
            "figmaVariable": "chart/critical",
            "reason": "ProgressBar tone=\"critical\" fill; Figma misuses text/critical as a fill. Interim alias of chart/negative",
            "wcag": ["1.4.11"],
            "approvedBy": ["maintainer"],
            "expires": "2027-01-31"
          }
        }
      }
    }
  }
}
