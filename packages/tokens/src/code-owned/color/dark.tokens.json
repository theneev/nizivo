{
  "color": {
    "elevation": {
      "highlight": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        }
      },
      "ring": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 0.08,
          "hex": "#ffffff"
        }
      }
    }
  }
}
