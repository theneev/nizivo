{
  "name": "@nizivo/tokens",
  "version": "0.2.1",
  "description": "Framework-neutral design tokens for Nizivo: CSS variables, theme scopes, motion and typed references",
  "keywords": [
    "css-variables",
    "design-system",
    "design-tokens",
    "nizivo"
  ],
  "homepage": "https://nizivo.neevtechnologies.in",
  "bugs": "https://github.com/theneev/nizivo/issues",
  "license": "Apache-2.0",
  "author": "Neev Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theneev/nizivo.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract.json": "./dist/contract.json",
    "./custom-media.css": "./dist/custom-media.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tz build -c build/terrazzo.config.ts && node scripts/a11y.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p test",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "tokens:pull:agent": "node scripts/figma/pull-agent.ts",
    "tokens:raw": "node scripts/figma/raw.ts",
    "tokens:codesyntax": "node scripts/figma/codesyntax-rewrite.ts",
    "tokens:normalize": "node scripts/normalize.ts",
    "tokens:normalize:check": "node scripts/normalize.ts --check",
    "tokens:spring": "node scripts/spring.ts",
    "tokens:spring:check": "node scripts/spring.ts --check",
    "tokens:check": "tz check -c build/terrazzo.config.ts",
    "tokens:build": "tz build -c build/terrazzo.config.ts",
    "tokens:contrast": "tz build -c build/terrazzo.config.ts && node scripts/a11y.ts --write"
  },
  "devDependencies": {
    "@nizivo/tooling": "workspace:*",
    "@nizivo/tsconfig": "workspace:*",
    "@nizivo/tsdown-preset": "workspace:*",
    "@terrazzo/cli": "catalog:",
    "@terrazzo/parser": "catalog:",
    "@terrazzo/plugin-css": "catalog:",
    "@terrazzo/token-tools": "catalog:",
    "@types/node": "catalog:",
    "lightningcss": "catalog:",
    "tokens-bruecke": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
