{
  "name": "@nizivo/tokens",
  "version": "0.0.0",
  "description": "Framework-neutral design tokens for Nizivo: CSS variables, theme scopes, motion and typed references",
  "keywords": [
    "css-variables",
    "design-system",
    "design-tokens",
    "nizivo"
  ],
  "homepage": "https://nizivo.neevtechnologies.in",
  "bugs": "https://github.com/theneev/nizivo/issues",
  "license": "Apache-2.0",
  "author": "Neev Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theneev/nizivo.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@nizivo/tsconfig": "workspace:*",
    "@nizivo/tsdown-preset": "workspace:*",
    "@terrazzo/cli": "catalog:",
    "@terrazzo/plugin-css": "catalog:",
    "@terrazzo/token-tools": "catalog:",
    "@types/node": "catalog:",
    "tokens-bruecke": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
