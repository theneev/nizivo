    --nz-space-10: 2.5rem;
    --nz-space-12: 3rem;
    --nz-space-16: 4rem;
    --nz-space-20: 5rem;
    --nz-space-24: 6rem;
    --nz-stagger-item: 40ms;
    --nz-surface-inner-highlight: inset 0 1px 0 0 rgb(255 255 255 / 0.7);
    --nz-text-accent: light-dark(var(--nz-p-green-700), var(--nz-p-lime-300));
    --nz-text-brand: light-dark(var(--nz-p-green-700), var(--nz-p-green-300));
    --nz-text-critical: light-dark(var(--nz-p-red-600), var(--nz-p-red-400));
    --nz-text-disabled: light-dark(var(--nz-p-neutral-400), var(--nz-p-neutral-600));
    --nz-text-info: light-dark(var(--nz-p-blue-600), var(--nz-p-blue-400));
    --nz-text-inverse: light-dark(var(--nz-p-neutral-0), var(--nz-p-neutral-900));
    --nz-text-on-accent: var(--nz-p-green-950);
    --nz-text-on-brand: light-dark(var(--nz-p-neutral-0), var(--nz-p-green-950));
    --nz-text-on-critical: var(--nz-p-neutral-0);
    --nz-text-primary: light-dark(var(--nz-p-neutral-900), var(--nz-p-neutral-50));
    --nz-text-secondary: light-dark(var(--nz-p-neutral-700), var(--nz-p-neutral-300));
    --nz-text-success: light-dark(var(--nz-p-green-600), var(--nz-p-green-300));
    --nz-text-tertiary: light-dark(var(--nz-p-neutral-600), var(--nz-p-neutral-400));
    --nz-text-warning: light-dark(var(--nz-p-amber-700), var(--nz-p-amber-500));
    --nz-tilt-max-deg: 6;
    --nz-tracking-body-l: 0em;
    --nz-tracking-body-m: 0em;
    --nz-tracking-body-m-strong: 0em;
    --nz-tracking-body-s: 0em;
    --nz-tracking-display-l: -0.03em;
    --nz-tracking-display-m: -0.025em;
    --nz-tracking-heading-h1: -0.02em;
    --nz-tracking-heading-h2: -0.015em;
    --nz-tracking-heading-h3: -0.01em;
    --nz-tracking-heading-h4: -0.005em;
    --nz-tracking-label-l: -0.002em;
    --nz-tracking-label-m: 0em;
    --nz-tracking-label-m-strong: 0em;
    --nz-tracking-label-s: 0em;
    --nz-tracking-mono-m: 0em;
    --nz-tracking-mono-m-strong: 0em;
    --nz-tracking-numeric-display: -0.03em;
    --nz-tracking-numeric-kpi: -0.025em;
    --nz-tracking-numeric-l: -0.015em;
    --nz-tracking-numeric-m: -0.005em;
    --nz-type-display: 2.25rem;
    --nz-type-h1: 1.5rem;
    --nz-type-kpi: 1.75rem;
    --nz-z-chrome: 200;
    --nz-z-overlay: 1000;
    --nz-z-raised: 1;
    --nz-z-sticky: 100;
    --nz-z-toast: 1100;
  }

  [data-nz-theme="light"] {
    color-scheme: light;
    --nz-scheme-inverse: dark;
  }
  [data-nz-theme="dark"] {
    color-scheme: dark;
    --nz-scheme-inverse: light;
  }
  [data-nz-theme="system"] {
    color-scheme: light dark;
    --nz-scheme-inverse: dark;
  }
  @media (prefers-color-scheme: dark) {
    [data-nz-theme="system"] {
      --nz-scheme-inverse: light;
    }
  }
  [data-nz-scheme="inverse"] {
    color-scheme: var(--nz-scheme-inverse);
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --nz-distance-float: 0rem;
      --nz-distance-lift: 0rem;
      --nz-distance-reveal: 0rem;
      --nz-duration-base: 120ms;
      --nz-duration-chart-draw: 0ms;
      --nz-duration-count-up: 0ms;
      --nz-duration-fade: 120ms;
      --nz-duration-fast: 0ms;
      --nz-duration-instant: 0ms;
      --nz-duration-pulse: 0ms;
      --nz-duration-slow: 120ms;
      --nz-duration-slower: 160ms;
      --nz-duration-spring: 120ms;
      --nz-duration-spring-soft: 120ms;
      --nz-easing-enter: linear;
      --nz-easing-exit: linear;
      --nz-easing-spring: linear;
      --nz-easing-spring-soft: linear;
      --nz-easing-standard: linear;
      --nz-magnetic-pull: 0rem;
      --nz-scale-enter: 1;
      --nz-scale-hover: 1;
      --nz-scale-press: 1;
      --nz-stagger-item: 0ms;
      --nz-tilt-max-deg: 0;
    }
  }
  [data-nz-motion="reduce"] {
    --nz-distance-float: 0rem;
    --nz-distance-lift: 0rem;
    --nz-distance-reveal: 0rem;
    --nz-duration-base: 120ms;
    --nz-duration-chart-draw: 0ms;
    --nz-duration-count-up: 0ms;
    --nz-duration-fade: 120ms;
    --nz-duration-fast: 0ms;
    --nz-duration-instant: 0ms;
    --nz-duration-pulse: 0ms;
    --nz-duration-slow: 120ms;
    --nz-duration-slower: 160ms;
    --nz-duration-spring: 120ms;
    --nz-duration-spring-soft: 120ms;
    --nz-easing-enter: linear;
    --nz-easing-exit: linear;
    --nz-easing-spring: linear;
    --nz-easing-spring-soft: linear;
    --nz-easing-standard: linear;
    --nz-magnetic-pull: 0rem;
    --nz-scale-enter: 1;
    --nz-scale-hover: 1;
    --nz-scale-press: 1;
    --nz-stagger-item: 0ms;
    --nz-tilt-max-deg: 0;
  }

  @media (width >= 40rem) {
    :root {
      --nz-grid-columns: 8;
      --nz-grid-gutter: 1.25rem;
      --nz-grid-margin: 1.5rem;
      --nz-layout-content-max: 61rem;
      --nz-layout-sidebar: 4.5rem;
      --nz-section-gap: 1.5rem;
      --nz-type-display: 2.75rem;
      --nz-type-h1: 1.75rem;
      --nz-type-kpi: 1.75rem;
    }
  }

  @media (width >= 80rem) {
    :root {
      --nz-grid-columns: 12;
      --nz-grid-gutter: 1.5rem;
      --nz-grid-margin: 2rem;
      --nz-layout-content-max: 80rem;
      --nz-layout-sidebar: 16.5rem;
      --nz-section-gap: 2rem;
      --nz-type-display: 3.5rem;
      --nz-type-h1: 2rem;
      --nz-type-kpi: 2rem;
    }
  }
}
